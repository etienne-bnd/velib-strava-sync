# ---------------------------------------------------------------------------
# Copier ce fichier en « .env » et renseigner les valeurs réelles.
# Le fichier .env est ignoré par git : il ne doit JAMAIS être commité.
# ---------------------------------------------------------------------------

# --- Compte Vélib' Métropole -----------------------------------------------
# Adresse e-mail utilisée pour se connecter sur velib-metropole.fr
VELIB_USERNAME=votre_email@exemple.com
VELIB_PASSWORD=votre_mot_de_passe

# --- API Strava -------------------------------------------------------------
# Créer une application sur https://www.strava.com/settings/api
# Le refresh token doit être obtenu avec le scope « activity:write ».
STRAVA_CLIENT_ID=votre_client_id
STRAVA_CLIENT_SECRET=votre_client_secret
STRAVA_REFRESH_TOKEN=votre_refresh_token

# --- API OpenRouteService ---------------------------------------------------
# Clé gratuite sur https://openrouteservice.org/dev/#/signup
ORS_API_KEY=votre_cle_ors

# --- Options (toutes facultatives) -----------------------------------------
# URL du dépôt, insérée dans la description des activités Strava.
PROJECT_REPO_URL=https://github.com/VOTRE_PSEUDO/velibsurstrava

# Nombre maximum de trajets traités par exécution (garde-fou de quota ORS).
MAX_TRIPS_PER_RUN=25

# Ne traite pas les trajets antérieurs à ce nombre de jours (0 = pas de limite).
MAX_TRIP_AGE_DAYS=30

# Simulation : construit les GPX mais n'envoie rien sur Strava (1 pour activer).
DRY_RUN=0
